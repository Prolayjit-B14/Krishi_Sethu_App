<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 🚀 ALLOW LOCAL HARDWARE COMMUNICATION -->
    <!-- This enables the app to talk to ESP32 / Local IPs over HTTP (Cleartext) -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Common IoT Subnets -->
        <domain includeSubdomains="true">192.168.4.1</domain> <!-- ESP32 AP Mode -->
        <domain includeSubdomains="true">192.168.4.2</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>

    <!-- 🌐 GLOBAL HTTPS REQUIREMENT -->
    <!-- Allow cleartext for dynamic local IP camera feeds on mobile hotspots -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
