rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ SECURITY: Strict User Data Isolation (Anti-IDOR)
    // Only the authenticated owner of an account can read or write their farm profile & telemetry
    match /farmers/{farmerEmail} {
      allow read, write: if request.auth != null && (request.auth.token.email == farmerEmail);
      
      // Subcollections (e.g. historical telemetry time-series)
      match /telemetry/{docId} {
        allow read, write: if request.auth != null && (request.auth.token.email == farmerEmail);
      }
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.token.email == farmerEmail);
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
