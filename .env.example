# -------------------------------------------------------------
# AgriSense Pro - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.
# NEVER commit .env to version control!
# -------------------------------------------------------------

# Firebase Client Configuration (From Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# MQTT Broker Configuration (e.g. HiveMQ Cloud WSS)
VITE_MQTT_BROKER=your_hivemq_instance.s1.eu.hivemq.cloud
VITE_MQTT_WSS_PORT=8884
VITE_MQTT_USER=your_mqtt_username
VITE_MQTT_PASS=your_mqtt_password

# External APIs
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_WEATHER_CITY=Kolkata

# Optional Initial Geo Location
VITE_MAP_LAT=23.4013
VITE_MAP_LNG=88.4960

# Optional Initial Admin Account (For offline field setup)
VITE_LOGIN_EMAIL=
VITE_LOGIN_PASSWORD=
